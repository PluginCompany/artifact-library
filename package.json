{
  "name": "@plugincompany/artifact-library",
  "version": "0.6.0",
  "description": "Self-hosted library for HTML artifacts made by people and AI agents: stable links, immutable versions, server-side previews and on-page feedback agents can read.",
  "keywords": [
    "artifacts",
    "ai-agents",
    "claude-code",
    "mcp",
    "static-hosting",
    "html",
    "versioning",
    "previews",
    "feedback",
    "self-hosted",
    "cli"
  ],
  "homepage": "https://github.com/plugincompany/artifact-library#readme",
  "bugs": {
    "url": "https://github.com/plugincompany/artifact-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plugincompany/artifact-library.git"
  },
  "license": "Apache-2.0",
  "author": "Plugin Company",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "artifact": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills/artifact-publishing/SKILL.md",
    "skills/artifact-publishing/references",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/embed-skill.mjs && node scripts/embed-media.mjs && tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "pretest": "node scripts/embed-skill.mjs && node scripts/embed-media.mjs",
    "check": "node scripts/embed-skill.mjs && node scripts/embed-media.mjs && tsc --noEmit",
    "check:public": "node scripts/check-public.mjs",
    "prepack": "npm run build",
    "build:binary": "npm run build && bun scripts/build-binary.ts",
    "build:binaries": "npm run build && bun scripts/build-binary.ts --all",
    "build:seed": "node scripts/build-seed.mjs",
    "release:local": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "fastify": "^5.6.0",
    "htmlparser2": "12.0.0",
    "ignore": "^7.0.5",
    "mime-types": "^3.0.1",
    "playwright": "1.64.0",
    "tar-stream": "^3.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.18.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
