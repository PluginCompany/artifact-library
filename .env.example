# Copy to .env and adjust. Used by compose.yaml.

# Origin used in links the API returns (no path). Use the address people will open.
PUBLIC_BASE_URL=http://localhost:3000

# 127.0.0.1 = this machine only. 0.0.0.0 = every interface (LAN, Tailscale, …).
BIND_ADDRESS=127.0.0.1
PORT=3000

# Required to publish, update, archive and purge when set. Strongly recommended
# whenever the server is reachable by anyone you don't fully trust.
# Generate one with: openssl rand -hex 32
# ARTIFACT_TOKEN=

# Per-publication upload limits (defaults: 500 MB and 10,000 files).
# MAX_UPLOAD_BYTES=524288000
# MAX_FILES=10000

# Server-side preview images are on in the full image and off in the -slim image.
# PREVIEWS=false
LOG_LEVEL=info

# Pin another image, e.g. the slim variant:
# ARTIFACT_IMAGE=ghcr.io/plugincompany/artifact-library:0.4.0-slim
